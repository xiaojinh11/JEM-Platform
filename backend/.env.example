# ============================================================
# Network Automation Workbench — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Core ---
APP_NAME=Network Automation Workbench
ENV=local
DEBUG=true

# --- Database ---
# PostgreSQL (production). Falls back to SQLite if empty (full offline).
DATABASE_URL=postgresql+psycopg2://naw:naw@postgres:5432/naw
# For fully offline: DATABASE_URL=sqlite:///./naw.db
DATABASE_ECHO=false

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security (change these!) ---
SECRET_KEY=ReplaceMeWithALongRandomSecretKeyAtLeast32Chars
JWT_ALGORITHM=HS256
# Access token lifetime (minutes). Short by design — refresh tokens
# (7 days, see NAW_REFRESH_TOKEN_EXPIRE_DAYS) carry the long-lived
# session, access tokens are rotated frequently so a stolen token
# has a narrow blast radius.
JWT_EXPIRE_MINUTES=15

# Fernet key: 32 url-safe base64 bytes.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=ReplaceMeWithARealFernetKey32BytesBase64

# --- Bootstrap admin account ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234

# --- Public URL used in password-reset email links ---
# Point this at the URL where the user opens the SPA. Default is the
# local dev frontend.
PUBLIC_BASE_URL=http://localhost:8080

# --- SMTP (required for registration & password reset emails) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@example.com

# --- SSH defaults ---
SSH_TIMEOUT_SECONDS=10
WEBSSH_IDLE_TIMEOUT_SECONDS=600
