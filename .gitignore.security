# Security-sensitive files - NEVER commit these
backend/.env
backend/.env.local
backend/.env.production
**/.env.backup.*
**/known_hosts
**/id_rsa*
**/id_ed25519*

# Storage directories containing device configs
storage/
*.sql
*.db

# Redis dumps
dump.rdb

# Backup files with timestamps
*.backup.*

# Python cache
__pycache__/
*.pyc
.venv/

# Node modules
node_modules/

# Docker volumes
pgdata/
naw_storage/
